{
  "name": "account-handoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "npm run verify:native && npm run generate:contracts && tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "build:testnet": "npm run verify:native && npm run generate:contracts && tsc --noEmit && vite build --config apps/web/vite.config.ts --mode testnet",
    "package:testnet": "node scripts/testnet/package.mjs",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:store": "vitest run tests/store",
    "test:browser": "playwright test",
    "generate:contracts": "node packages/contracts/scripts/generate.mjs",
    "format:check": "prettier --check apps packages scripts tests infra package.json tsconfig.json vitest.config.ts playwright.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "doctor": "node scripts/dev/doctor.mjs",
    "local:plan": "node scripts/local/plan.mjs",
    "local:build": "node scripts/local/build.mjs",
    "local:up": "node scripts/local/up.mjs",
    "local:status": "node scripts/local/status.mjs",
    "local:stop": "node scripts/local/stop.mjs",
    "local:reset": "node scripts/local/reset.mjs",
    "local:qualify": "node scripts/local/qualify.mjs",
    "local:capabilities": "node scripts/local/capabilities.mjs",
    "local:deploy": "node scripts/local/deploy.mjs",
    "local:seed": "node scripts/local/seed.mjs",
    "local:handoff": "node scripts/local/handoff.mjs",
    "local:test": "node scripts/local/test.mjs",
    "compile:contract": "node scripts/local/compile-contract.mjs",
    "local:reconcile": "node scripts/local/reconcile.mjs",
    "local:refresh-descriptor": "node scripts/local/refresh-descriptor.mjs",
    "generate:native": "node scripts/dev/generate-native.mjs",
    "verify:native": "node scripts/dev/verify-generated-native.mjs"
  },
  "dependencies": {
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "canonicalize": "5.1.0",
    "dedot": "1.4.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.40.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@polkadot/keyring": "14.0.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "fake-indexeddb": "6.2.6",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "solc": "0.8.24",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "viem": {
      "ws": "8.22.0"
    },
    "tmp": "0.2.7"
  }
}
