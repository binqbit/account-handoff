# Docker Compose settings for the LOCAL native node and Revive gateway.
# Copy this file to .env before the first container startup.
# Pass the root .env explicitly because the Compose file is in infra/local.
# Run from the repository root:
# docker compose --env-file .env -f infra/local/compose.yaml up -d --build

# A distinct project name keeps this stack's containers and volumes separate.
AH_RUN_ID=docker-local

# Published loopback ports. These defaults can coexist with the host launcher,
# which normally uses 9944 and 8545. Container-internal ports stay unchanged.
AH_NATIVE_PORT=9966
AH_GATEWAY_PORT=8566

# Public operator reference for the original Vestry deployed on PortalDot V3.
# Static testnet builds use infra/testnet/network.json, without loading .env.
AH_TESTNET_VESTRY_ADDRESS=0xb8e2d057cf231f265dd6f3841216f4727edad345
