{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grc:portable-package:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "scope",
    "records",
    "recordIdentityMap",
    "sourceInputs",
    "localContractRevision"
  ],
  "properties": {
    "format": {
      "const": "grc.native-record-package"
    },
    "version": {
      "const": "2"
    },
    "scope": {
      "const": "portable_unsigned_evidence"
    },
    "records": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "urn:grc:contracts:2"
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "SignedAttempt"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "recordScope": {
                  "const": "portable_export"
                },
                "signedExtrinsicBytes": {
                  "const": null
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "recordIdentityMap": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "oldRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "oldDigest": {
            "$ref": "urn:grc:contracts:2#/$defs/Sha256"
          },
          "newRecordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "newDigest": {
            "$ref": "urn:grc:contracts:2#/$defs/Sha256"
          },
          "reason": {
            "type": "string",
            "enum": [
              "signed_bytes_redaction",
              "reference_remap"
            ]
          }
        },
        "required": [
          "oldRecordId",
          "oldDigest",
          "newRecordId",
          "newDigest",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "sourceInputs": {
      "type": "array",
      "items": {
        "$ref": "urn:grc:contracts:2#/$defs/EvidenceRef"
      }
    },
    "localContractRevision": {
      "const": "grc-v2-local-1"
    }
  },
  "description": "Maximum UTF-8 input 5242880 bytes, nesting depth32, duplicate-key/lone-surrogate rejection before schema validation. Seven canonical records; no local progress or signed packets. All record IDs/digests/references must be reconciled. Imported acceptance flags confer no authority.",
  "localContractRevision": "grc-v2-local-1"
}
